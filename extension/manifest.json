{
  "manifest_version": 3,
  "name": "Truvala",
  "version": "0.1.0",
  "description": "AI homebuying decision overlay",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zillow.com/*",
        "*://*.trulia.com/*",
        "*://*.redfin.com/*",
        "*://*.realtor.com/*",
        "*://*.homes.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
