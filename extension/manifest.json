{
  "manifest_version": 3,
  "name": "Truvala",
  "version": "0.1.0",
  "description": "AI homebuying decision overlay",
  "permissions": [],
  "host_permissions": ["http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.zillow.com/*",
        "*://*.trulia.com/*",
        "*://*.redfin.com/*",
        "*://*.realtor.com/*",
        "*://*.homes.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
